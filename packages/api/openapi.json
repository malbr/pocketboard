{
  "openapi": "3.0.3",
  "info": {
    "title": "PocketBoard API",
    "version": "0.0.0",
    "description": "Owner-only REST API. The web app reaches it under /api."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "ownerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pocketboard.sid",
        "description": "Session cookie issued after the owner signs in with GitHub."
      }
    },
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "doing",
              "done"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "createdAt",
          "version"
        ],
        "additionalProperties": false
      },
      "CardList": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "status": {
              "type": "string",
              "enum": [
                "backlog",
                "doing",
                "done"
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true
            }
          },
          "required": [
            "id",
            "title",
            "status",
            "createdAt",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "githubUserId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "csrfToken": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "authenticated",
          "githubUserId",
          "csrfToken",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "AuthError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "authentication_required",
              "access_denied",
              "csrf_token_invalid",
              "invalid_oauth_state",
              "oauth_exchange_failed"
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "InternalError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "internal_error"
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "InvalidCardInput": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_card_input"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "error",
          "issues"
        ],
        "additionalProperties": false
      },
      "CardNotFound": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "card_not_found"
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "CardVersionConflict": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "card_version_conflict"
            ]
          },
          "card": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "status": {
                "type": "string",
                "enum": [
                  "backlog",
                  "doing",
                  "done"
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "version": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              }
            },
            "required": [
              "id",
              "title",
              "status",
              "createdAt",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error",
          "card"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "HealthUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "RateLimited": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "rate_limited"
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check, including a PostgreSQL round trip",
        "responses": {
          "200": {
            "description": "API is up and PostgreSQL answered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL did not answer or timed out; no detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                }
              }
            }
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "summary": "Start GitHub sign-in",
        "responses": {
          "302": {
            "description": "Redirect to GitHub authorization"
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "summary": "Complete GitHub sign-in",
        "responses": {
          "302": {
            "description": "Signed in; redirect to the app"
          },
          "400": {
            "description": "OAuth state did not match",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "The GitHub account is not the owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          },
          "502": {
            "description": "GitHub code exchange failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Current owner session and CSRF token",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signed in as the owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Signed in as someone other than the owner, or CSRF token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Sign out",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Token from GET /auth/session"
            },
            "required": true,
            "name": "x-csrf-token",
            "in": "header"
          }
        ],
        "responses": {
          "204": {
            "description": "Session destroyed"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Signed in as someone other than the owner, or CSRF token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/cards": {
      "get": {
        "summary": "List cards, newest first",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "All cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Signed in as someone other than the owner, or CSRF token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a card",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Token from GET /auth/session"
            },
            "required": true,
            "name": "x-csrf-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidCardInput"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Signed in as someone other than the owner, or CSRF token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/cards/{cardId}": {
      "patch": {
        "summary": "Move a card, guarded by its version",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "cardId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Token from GET /auth/session"
            },
            "required": true,
            "name": "x-csrf-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "backlog",
                      "doing",
                      "done"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  }
                },
                "required": [
                  "status",
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Moved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "400": {
            "description": "Invalid identifier or input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidCardInput"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Signed in as someone other than the owner, or CSRF token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "No such card",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardNotFound"
                }
              }
            }
          },
          "409": {
            "description": "Stale version; the current card is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardVersionConflict"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a card, guarded by its version",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "cardId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Token from GET /auth/session"
            },
            "required": true,
            "name": "x-csrf-token",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  }
                },
                "required": [
                  "version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted; the card as it stood when removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "400": {
            "description": "Invalid identifier or input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidCardInput"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Signed in as someone other than the owner, or CSRF token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "No such card",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardNotFound"
                }
              }
            }
          },
          "409": {
            "description": "Stale version; the current card is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardVersionConflict"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the budget resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimited"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure; no internal detail is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    }
  }
}
