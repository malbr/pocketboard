{
  "name": "@pocketboard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsx src/bundle/cli.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "openapi:generate": "tsx src/openapi/cli.ts write",
    "openapi:check": "tsx src/openapi/cli.ts check"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/oauth2": "8.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/session": "11.1.3",
    "@pocketboard/shared": "0.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
