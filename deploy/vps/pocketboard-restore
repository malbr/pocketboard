#!/usr/bin/env bash
# Database restore (issue #8). Installed root-owned at
# /usr/local/sbin/pocketboard-restore. Run by hand as root, only after the
# restore's own human approval gate; the deploy account cannot reach it.
#
#   pocketboard-restore <restic snapshot id>
#
# 1. Read the snapshot's dump and prove it is a readable pg_dump archive.
# 2. Restore it into a new, empty database, stopping at the first error and
#    rolling the whole restore back.
# 3. Verify the restored database: cards are readable and the Drizzle
#    migration ledger is not empty.
# 4. Only then stop api and web, and swap both database names in one
#    transaction. The replaced database is kept, renamed.
# Any failure before step 4 exits non-zero with the live database and the
# running application untouched. A failure while stopping the application
# restarts what was stopped, and every failed restart is reported. Once the
# swap has been sent, nothing restarts automatically: after an error from it
# the application stays stopped, unless PostgreSQL shows the swap committed,
# and the owner decides using the runbook. Every database call from the name
# check onwards has a deadline. `pg_restore --clean` into the live
# database is never used: it drops only objects in the dump and leaves newer
# ones behind.
set -euo pipefail
umask 077

env_file="${POCKETBOARD_BACKUP_ENV:-/etc/pocketboard/backup.env}"
tmp_root="${POCKETBOARD_BACKUP_TMP:-/var/lib/pocketboard/backup-tmp}"
owner_uid="${POCKETBOARD_EXPECTED_OWNER_UID:-0}"
project="${POCKETBOARD_COMPOSE_PROJECT:-pocketboard}"
# Deadlines, in seconds, for each database call around the swap.
check_timeout="${POCKETBOARD_CHECK_TIMEOUT:-10}"
swap_timeout="${POCKETBOARD_SWAP_TIMEOUT:-120}"
export RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-/var/cache/pocketboard-restic}"

log() { printf '%s restore: %s\n' "$(date -u +%FT%TZ)" "$*"; }
die() { log "FAILED: $*" >&2; exit 1; }

if [[ $# -ne 1 || ! "$1" =~ ^[0-9a-f]{8,64}$ ]]; then
  echo "usage: pocketboard-restore <restic snapshot id>" >&2
  exit 2
fi
snapshot="$1"

[[ -f "$env_file" ]] || die "$env_file is missing"
[[ "$(stat -c '%u %a' "$env_file")" == "$owner_uid 600" ]] \
  || die "$env_file must be owned by uid $owner_uid with mode 600"
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

restic cat config > /dev/null || die "the Restic repository is unreachable or not initialised"

# Plain assignments, so a failed docker call stops the script under set -e.
containers() {
  docker ps --quiet --filter "label=com.docker.compose.project=$project" \
    --filter "label=com.docker.compose.service=$1" --filter status=running
}
pg="$(containers postgres)"
[[ -n "$pg" && "$pg" != *$'\n'* ]] || die "expected exactly one running pocketboard postgres container"
psql() { docker exec -i "$pg" psql -U pocketboard -X -q -v ON_ERROR_STOP=1 "$@"; }

stopped=()
# prepare, stopping, swapping or done: what a failure at this point leaves.
phase=prepare

# Starts every container this run stopped, and says which could not start.
restart_stopped() {
  local id failed=()
  for id in "${stopped[@]}"; do
    if docker start "$id" > /dev/null; then
      log "restarted $id"
    else
      failed+=("$id")
    fi
  done
  (( ${#failed[@]} == 0 )) && return 0
  log "FAILED to restart ${failed[*]}; start them by hand" >&2
  return 1
}

# A failure (or Ctrl-C, or a closed session) while stopping the application
# restarts what was stopped: nothing has been swapped yet, so the previous
# release still matches the live database. Once the swap has been sent,
# nothing restarts automatically. Recovery runs first and never stops at a
# failing step, so a failed cleanup cannot prevent it.
on_exit() {
  local status=$?
  set +e
  if (( status != 0 )); then
    case "$phase" in
      stopping) restart_stopped ;;
      swapping) log "interrupted during the swap; api and web are left stopped." \
        "Follow the runbook's steps for a swap error before starting anything" >&2 ;;
    esac
  fi
  rm -rf "$work" || log "WARNING: could not remove $work; delete it by hand" >&2
}

mkdir -p "$tmp_root"
chmod 700 "$tmp_root"
work="$(mktemp -d "$tmp_root/restore.XXXXXX")"
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
dump="$work/pocketboard.dump"

restic dump "$snapshot" /pocketboard.dump > "$dump" || die "cannot read /pocketboard.dump from snapshot $snapshot"
[[ "$(head -c 5 "$dump")" == PGDMP ]] || die "the snapshot does not hold a custom-format pg_dump archive"
docker exec -i "$pg" pg_restore --list < "$dump" > /dev/null || die "pg_restore cannot read the dump"

psql -d postgres -c 'DROP DATABASE IF EXISTS pocketboard_restore' \
  -c 'CREATE DATABASE pocketboard_restore TEMPLATE template0' \
  || die "cannot create the empty pocketboard_restore database"
docker exec -i "$pg" pg_restore -U pocketboard -d pocketboard_restore --exit-on-error --single-transaction \
  --no-owner < "$dump" || die "the restore failed and was rolled back; the live database is unchanged"

cards="$(psql -d pocketboard_restore -tAc 'SELECT count(*) FROM cards')" \
  || die "the restored database has no readable cards table"
[[ "$cards" =~ ^[0-9]+$ ]] || die "unexpected cards count: $cards"
ledger="$(psql -d pocketboard_restore -tAc \
  "SELECT count(*) || ' ' || coalesce(max(created_at)::text, '') FROM drizzle.__drizzle_migrations")" \
  || die "the restored database has no Drizzle migration ledger"
[[ "$ledger" =~ ^([1-9][0-9]*)\ ([0-9]+)$ ]] || die "the restored Drizzle migration ledger is empty"
migrations="${BASH_REMATCH[1]}"
last_when="${BASH_REMATCH[2]}"
log "verified pocketboard_restore: $cards cards, $migrations migrations, last migration when $last_when"

# One database call with a deadline, so no check can hang the run. A call cut
# off by the deadline fails like any other.
psql_within() {
  local seconds="$1"
  shift
  timeout --kill-after=5 "$seconds" docker exec -i "$pg" psql -U pocketboard -X -q -v ON_ERROR_STOP=1 "$@"
}

# Lower case only: PostgreSQL folds an unquoted name, and the check after a
# swap error looks the name up exactly. It must be new, so that a committed
# swap can be recognised.
replaced="pocketboard_before_restore_$(date -u +%Y%m%d_%H%M%S)"
taken="$(psql_within "$check_timeout" -d postgres -tAc "SELECT count(*) FROM pg_database WHERE datname = '$replaced'")" \
  || die "cannot list the databases; nothing was stopped"
[[ "$taken" == 0 ]] || die "a database named $replaced already exists; nothing was stopped"

# Renaming a database needs every session on it closed. Both services are
# looked up before either stops.
web_ids="$(containers web)" || die "cannot look up the web containers; nothing was stopped"
api_ids="$(containers api)" || die "cannot look up the api containers; nothing was stopped"
phase=stopping
for id in $web_ids $api_ids; do
  # Recorded first: a stop that fails part-way may still have stopped it.
  stopped+=("$id")
  docker stop "$id" > /dev/null || die "cannot stop $id; nothing was swapped"
done

# After an error from the swap command, the script cannot prove the swap will
# not still commit: the server can commit after the client lost its response,
# and a command Docker accepted can reach PostgreSQL late. So it never
# restarts anything once the swap has been sent. It reads the names once,
# with a deadline, and leaves the decision to the owner (see the runbook).
phase=swapping
if timeout --kill-after=5 "$swap_timeout" docker exec -i -e PGAPPNAME=pocketboard-restore-swap "$pg" \
  psql -U pocketboard -X -q -v ON_ERROR_STOP=1 -d postgres \
  -c "BEGIN; ALTER DATABASE pocketboard RENAME TO $replaced; ALTER DATABASE pocketboard_restore RENAME TO pocketboard; COMMIT;"; then
  phase=done
else
  phase=done
  names="$(psql_within "$check_timeout" -d postgres -tAc "SELECT string_agg(datname, ' ' ORDER BY datname COLLATE \"C\")
    FROM pg_database WHERE datname IN ('pocketboard', 'pocketboard_restore', '$replaced')")" || names=""
  case "$names" in
    "pocketboard $replaced")
      log "WARNING: the swap command reported an error, but PostgreSQL shows the swap committed" >&2 ;;
    "pocketboard pocketboard_restore")
      die "the swap reported an error. PostgreSQL still shows the original names, but a delayed swap cannot be" \
        "ruled out; api and web are left stopped. Follow the runbook's steps for a swap error" ;;
    *)
      die "the swap reported an error and its outcome could not be established; api and web are left stopped." \
        "Follow the runbook's steps for a swap error" ;;
  esac
fi
log "swapped: pocketboard is the restored database; the replaced one is $replaced"
log "api and web are stopped. Start the release whose migration journal ends at when $last_when with an authorized rollback"
