#!/usr/bin/env bash
# Pre-deploy backup (issue #8). Installed root-owned at
# /usr/local/sbin/pocketboard-backup and run only by pocketboard-deploy,
# before any migration.
#
#   pocketboard-backup <release sha>
#
# 1. Dump the running PostgreSQL container to a root-only temporary file.
# 2. Prove the dump is a readable pg_dump archive before uploading it.
# 3. Refuse an oversized dump, apply retention, and refuse the upload unless
#    Restic's own machine-readable evidence, complete and free of warnings,
#    shows the repository stays inside the source-controlled limits below
#    (issues #37 and #39).
# 4. Upload it to the Restic repository on Cloudflare R2 (encrypted by Restic).
# 5. Read the snapshot back and require the same SHA-256 as the local dump.
# 6. Apply retention again, require the new snapshot to have survived it, and
#    re-check the limits over it.
# 7. Delete the local dump on every exit path.
# Any failure exits non-zero, which stops the deploy before migrations run.
# Output names the snapshot, size and checksum only; never credentials.
set -euo pipefail
umask 077

env_file="${POCKETBOARD_BACKUP_ENV:-/etc/pocketboard/backup.env}"
tmp_root="${POCKETBOARD_BACKUP_TMP:-/var/lib/pocketboard/backup-tmp}"
owner_uid="${POCKETBOARD_EXPECTED_OWNER_UID:-0}"

# Cost guard (issue #37). These limits are source-controlled on purpose, and
# read-only before backup.env is sourced, so neither the environment nor the
# settings file can raise them: relaxing one takes a reviewed repository
# change. They bound what this POC can store in R2; they are not a billing cap.
readonly max_dump_bytes=$((100 * 1024 * 1024))
readonly max_raw_bytes=$((2 * 1024 * 1024 * 1024))
readonly max_snapshots=20

log() { printf '%s backup: %s\n' "$(date -u +%FT%TZ)" "$*"; }
die() { log "FAILED: $*" >&2; exit 1; }

# Retention is mandatory in both places it runs. It is what keeps a POC
# repository inside the limits above, so a failed forget/prune stops the deploy
# instead of being reported (issue #37; it used to be a warning). A warning is a
# failure too: Restic 0.16.4 skips a snapshot it cannot load, exits 0, and so
# neither keeps nor removes it (issue #39). `forget --prune` only prunes when the
# policy selects a snapshot to remove, so a run that removes none prunes nothing.
retain() { # <stage>
  restic forget --host pocketboard --tag pocketboard --group-by host --keep-last 5 \
    --keep-daily 7 --keep-weekly 4 --keep-monthly 3 --prune > /dev/null 2> "$work/retain.err" \
    || die "retention (restic forget --prune) failed $1"
  [[ ! -s "$work/retain.err" ]] \
    || die "retention (restic forget --prune) warned $1, so it may have skipped snapshots"
}

# Restic 0.16.4 prints one JSON object for `stats --json`, down to
# {"total_size":0,"snapshots_count":0} on an empty repository. Only an
# unambiguous, plainly non-negative integer of at most 15 digits counts as
# evidence: a missing, repeated, signed, fractional or implausibly large field
# is a failure rather than a zero, because the quota decisions rest entirely on
# these two numbers. The digit bound also keeps the arithmetic below inside
# Bash's signed 64-bit range.
restic_number() { # <validated statistics json> <key>
  local json="$1" key="$2" hits value
  # read_quota_evidence has already proved the payload's shape and that its keys
  # are unique, so this only has to find the one pair and bound its value. It
  # runs where errexit does not apply, so every step checks its own status: a
  # utility that prints the right text and then fails is not evidence (PR #38
  # exact-final review, finding 2). grep failing to find the key fails here too.
  hits="$(grep -o -- "\"$key\":" <<< "$json" | wc -l)" || return 1
  [[ "$hits" == 1 ]] || return 1
  value="$(sed -n "s/.*\"$key\":\([^,}]*\).*/\1/p" <<< "$json")" || return 1
  # Zero padding is refused with the rest: Bash would read 0999 as an invalid
  # octal literal and abort the arithmetic instead of rejecting the evidence.
  [[ "$value" =~ ^(0|[1-9][0-9]{0,14})$ ]] || return 1
  printf '%s' "$value"
}

# Sets raw_bytes and snapshot_count from one repository-wide report, checked
# against the repository's own list of snapshot files, and keeps that list in
# listed_ids, or exits.
#
# Restic 0.16.4 prints one flat JSON object of "key":<number> pairs, down to
# {"total_size":0,"snapshots_count":0} on a repository that has only been
# initialised. The whole payload is matched against that grammar before anything
# is read out of it, because searching for keys in text cannot tell evidence
# from noise: a field duplicated as a JSON escape ("total\u005fsize"), a
# trailing comma or a string value all read as a clean small number otherwise
# (PR #38 re-review, finding 1). Anything outside the grammar fails closed,
# including a future Restic that adds a non-numeric field, which is why ADR 0009
# makes re-verifying this parser part of a Restic upgrade.
read_quota_evidence() {
  local json pair keys all_bytes kept_bytes key_count unique_count reply="$work/stats.json"
  restic stats --mode raw-data --json > "$reply" 2> "$work/stats.err" \
    || die "restic could not report repository size and snapshot evidence"
  # Restic 0.16.4 skips a snapshot it cannot load with a warning, exits 0 and
  # reports the rest, and when it loads none its report is exactly an empty
  # repository's (issue #39). A healthy run writes nothing to stderr, so any
  # warning at all, whatever its wording, makes the report incomplete. It is not
  # echoed: the command is documented for reproducing it by hand.
  [[ ! -s "$work/stats.err" ]] \
    || die "restic warned while reporting the repository, so its evidence may be incomplete"
  # Command substitution strips every trailing LF, which would pass a reply
  # ending in several as one ending in none. The sentinel keeps them, then the
  # single LF Restic writes is removed and any other is left for the grammar
  # below to refuse (PR #40 review, finding 2). `&&` keeps cat's failure.
  json="$(cat "$reply" && printf x)" || die "the quota check could not read restic statistics"
  json="${json%x}"
  json="${json%$'\n'}"
  # Bash discards NUL bytes when it reads a command's output into a string, so an
  # unreadable reply could arrive as a plausible one. Compare what Restic wrote
  # with what survives that conversion before trusting the string below
  # (PR #38 third pass). Each count is captured and its status checked before
  # the comparison, because (( )) ignores the status of the commands that
  # produce its operands (PR #38 exact-final review, finding 2).
  all_bytes="$(wc -c < "$reply")" || die "the quota check could not measure restic statistics"
  kept_bytes="$(tr -d '\000' < "$reply" | wc -c)" \
    || die "the quota check could not measure restic statistics"
  [[ "$all_bytes" =~ ^[0-9]+$ && "$all_bytes" == "$kept_bytes" ]] \
    || die "restic statistics contain bytes this check cannot read"
  # The number grammar is JSON's, so a spelling JSON forbids is refused even in a
  # field the quota never reads: a reply that is not valid JSON is not evidence.
  pair='"[a-z_]+":-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?'
  [[ "$json" =~ ^[{]${pair}(,${pair})*[}]$ ]] \
    || die "restic statistics are not the flat JSON object this check reads"
  keys="$(grep -o -- '"[a-z_]*":' <<< "$json" | sort)" \
    || die "the quota check could not compare the fields of restic statistics"
  key_count="$(wc -l <<< "$keys")" \
    || die "the quota check could not compare the fields of restic statistics"
  unique_count="$(sort -u <<< "$keys" | wc -l)" \
    || die "the quota check could not compare the fields of restic statistics"
  [[ "$key_count" =~ ^[1-9][0-9]*$ && "$key_count" == "$unique_count" ]] \
    || die "restic statistics repeat a field, so the evidence is ambiguous"
  raw_bytes="$(restic_number "$json" total_size)" \
    || die "restic reported no usable total_size for the repository"
  snapshot_count="$(restic_number "$json" snapshots_count)" \
    || die "restic reported no usable snapshots_count for the repository"

  # A skipped snapshot need not be announced for the report to be incomplete.
  # `restic list snapshots` names every snapshot file without loading one, so a
  # report that counted fewer snapshots than there are files left some out
  # (issue #39). The reply must be exactly one 64-hex id per line: its size is
  # checked because Bash would silently drop a NUL from what it reads.
  local id size
  restic list snapshots > "$work/snapshots" 2> "$work/snapshots.err" \
    || die "restic could not list the repository's snapshot files"
  [[ ! -s "$work/snapshots.err" ]] \
    || die "restic warned while listing the repository's snapshot files"
  mapfile -t listed_ids < "$work/snapshots"
  size="$(stat -c %s "$work/snapshots")" \
    || die "the snapshot file list could not be measured"
  [[ "$size" =~ ^(0|[1-9][0-9]{0,14})$ && "$size" == "$(( 65 * ${#listed_ids[@]} ))" ]] \
    || die "restic listed snapshot files this check cannot read"
  for id in "${listed_ids[@]}"; do
    [[ "$id" =~ ^[0-9a-f]{64}$ ]] || die "restic listed snapshot files this check cannot read"
  done
  (( ${#listed_ids[@]} == snapshot_count )) || die "restic statistics counted $snapshot_count" \
    "snapshot(s) but the repository holds ${#listed_ids[@]} snapshot file(s), so the evidence is incomplete"
}

if [[ $# -ne 1 || ! "$1" =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: pocketboard-backup <40-character release sha>" >&2
  exit 2
fi
sha="$1"

# The file holds the R2 key and the Restic password, so anything but a
# root-owned 0600 file is refused rather than read.
[[ -f "$env_file" ]] || die "$env_file is missing"
[[ "$(stat -c '%u %a' "$env_file")" == "$owner_uid 600" ]] \
  || die "$env_file must be owned by uid $owner_uid with mode 600"
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a
for name in RESTIC_REPOSITORY RESTIC_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
  [[ -n "${!name:-}" ]] || die "$name is not set in $env_file"
done

restic cat config > /dev/null || die "the Restic repository is unreachable or not initialised"

pg="$(docker ps --quiet --filter label=com.docker.compose.project=pocketboard \
  --filter label=com.docker.compose.service=postgres --filter status=running)"
[[ -n "$pg" && "$pg" != *$'\n'* ]] || die "expected exactly one running pocketboard postgres container"

mkdir -p "$tmp_root"
chmod 700 "$tmp_root"
work="$(mktemp -d "$tmp_root/run.XXXXXX")"
trap 'rm -rf "$work"' EXIT
dump="$work/pocketboard.dump"

docker exec "$pg" pg_dump --username=pocketboard --dbname=pocketboard --format=custom > "$dump"
[[ "$(head -c 5 "$dump")" == PGDMP ]] || die "pg_dump did not produce a custom-format archive"
docker exec -i "$pg" pg_restore --list < "$dump" > "$work/toc" || die "pg_restore cannot read the dump"
local_sum="$(sha256sum "$dump" | cut -d' ' -f1)"
bytes="$(stat -c %s "$dump")" || die "the dump could not be measured"
log "local dump verified: $bytes bytes, $(grep -c '^[0-9]' "$work/toc" || true) archive entries, sha256 $local_sum"

# Refused before retention and before any upload. It is not refused before every
# repository write: `restic cat config` above already took a lock, which in
# Restic 0.16.4 writes and then removes a lock object (issue #39).
(( bytes <= max_dump_bytes )) || die \
  "the dump is $bytes bytes and the limit is $max_dump_bytes bytes (100 MiB)"

# Quota preflight. Retention runs first and has to succeed: a repository that
# already sits at the snapshot limit must be able to come back under it, and
# the decision is only trustworthy on the repository Restic leaves behind.
# The whole dump size is charged to the projection even though Restic will
# deduplicate and compress it, which keeps the estimate conservative.
retain "before the upload"
read_quota_evidence
projected=$(( raw_bytes + bytes ))
(( projected <= max_raw_bytes )) || die \
  "the upload would project $projected bytes of raw data and the limit is $max_raw_bytes bytes (2 GiB)"
(( snapshot_count < max_snapshots )) || die \
  "the repository holds $snapshot_count snapshots and the limit is $max_snapshots"
log "quota preflight: $raw_bytes bytes of raw data, $snapshot_count snapshot(s), projecting $projected bytes"

# One stable path for every snapshot: Restic's retention groups by host and
# path by default, and a per-run name would give each snapshot its own group.
# The release is recorded in a tag and the time in the snapshot itself.
name="pocketboard.dump"
restic backup --json --host pocketboard --tag pocketboard --tag pre-deploy --tag "sha-$sha" \
  --stdin --stdin-filename "$name" < "$dump" > "$work/backup.json"
snapshot="$(grep -o '"snapshot_id":"[0-9a-f]*"' "$work/backup.json" | cut -d'"' -f4 | tail -n 1)"
[[ "$snapshot" =~ ^[0-9a-f]{8,64}$ ]] || die "restic reported no snapshot id"

remote_sum="$(restic dump "$snapshot" "/$name" | sha256sum | cut -d' ' -f1)"
[[ "$remote_sum" == "$local_sum" ]] || die "snapshot $snapshot does not match the local dump"

# Quota postflight: retention again, then the same evidence re-read over the new
# snapshot. An upload that took the repository past a limit stops this deploy
# even though the snapshot itself is verified. Refusing here does not undo the
# upload, so it can repeat until the repository is made smaller; what it buys is
# that the deploy stops now instead of the limit surfacing on a later run.
retain "after the verified upload"
read_quota_evidence
# Retention keeps snapshots by their recorded time, not upload order, so seven
# earlier snapshots dated later than this one, say from a host clock that ran
# ahead, leave it outside every keep rule and it is forgotten. The size and
# count can still look healthy, so the deploy stops unless the verified
# snapshot is still in the repository (PR #40 review, finding 1).
survived=no
for id in "${listed_ids[@]}"; do
  [[ "$id" == "$snapshot" ]] && survived=yes
done
[[ "$survived" == yes ]] || die "retention removed the verified snapshot $snapshot, so this deploy has" \
  "no pre-deploy backup; check the host clock and the snapshot times"
(( raw_bytes <= max_raw_bytes )) || die \
  "the repository holds $raw_bytes bytes of raw data and the limit is $max_raw_bytes bytes (2 GiB)"
(( snapshot_count <= max_snapshots )) || die \
  "the repository holds $snapshot_count snapshots and the limit is $max_snapshots"
log "quota postflight: $raw_bytes bytes of raw data, $snapshot_count snapshot(s)"

log "verified backup: snapshot $snapshot, file /$name, $bytes bytes, sha256 $local_sum"
