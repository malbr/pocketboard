#!/usr/bin/env bash
# Pre-deploy backup (issue #8). Installed root-owned at
# /usr/local/sbin/pocketboard-backup and run only by pocketboard-deploy,
# before any migration.
#
#   pocketboard-backup <release sha>
#
# 1. Dump the running PostgreSQL container to a root-only temporary file.
# 2. Prove the dump is a readable pg_dump archive before uploading it.
# 3. Upload it to the Restic repository on Cloudflare R2 (encrypted by Restic).
# 4. Read the snapshot back and require the same SHA-256 as the local dump.
# 5. Delete the local dump on every exit path.
# Any failure exits non-zero, which stops the deploy before migrations run.
# Output names the snapshot, size and checksum only; never credentials.
set -euo pipefail
umask 077

env_file="${POCKETBOARD_BACKUP_ENV:-/etc/pocketboard/backup.env}"
tmp_root="${POCKETBOARD_BACKUP_TMP:-/var/lib/pocketboard/backup-tmp}"
owner_uid="${POCKETBOARD_EXPECTED_OWNER_UID:-0}"

log() { printf '%s backup: %s\n' "$(date -u +%FT%TZ)" "$*"; }
die() { log "FAILED: $*" >&2; exit 1; }

if [[ $# -ne 1 || ! "$1" =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: pocketboard-backup <40-character release sha>" >&2
  exit 2
fi
sha="$1"

# The file holds the R2 key and the Restic password, so anything but a
# root-owned 0600 file is refused rather than read.
[[ -f "$env_file" ]] || die "$env_file is missing"
[[ "$(stat -c '%u %a' "$env_file")" == "$owner_uid 600" ]] \
  || die "$env_file must be owned by uid $owner_uid with mode 600"
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a
for name in RESTIC_REPOSITORY RESTIC_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
  [[ -n "${!name:-}" ]] || die "$name is not set in $env_file"
done

restic cat config > /dev/null || die "the Restic repository is unreachable or not initialised"

pg="$(docker ps --quiet --filter label=com.docker.compose.project=pocketboard \
  --filter label=com.docker.compose.service=postgres --filter status=running)"
[[ -n "$pg" && "$pg" != *$'\n'* ]] || die "expected exactly one running pocketboard postgres container"

mkdir -p "$tmp_root"
chmod 700 "$tmp_root"
work="$(mktemp -d "$tmp_root/run.XXXXXX")"
trap 'rm -rf "$work"' EXIT
dump="$work/pocketboard.dump"

docker exec "$pg" pg_dump --username=pocketboard --dbname=pocketboard --format=custom > "$dump"
[[ "$(head -c 5 "$dump")" == PGDMP ]] || die "pg_dump did not produce a custom-format archive"
docker exec -i "$pg" pg_restore --list < "$dump" > "$work/toc" || die "pg_restore cannot read the dump"
local_sum="$(sha256sum "$dump" | cut -d' ' -f1)"
bytes="$(stat -c %s "$dump")"
log "local dump verified: $bytes bytes, $(grep -c '^[0-9]' "$work/toc" || true) archive entries, sha256 $local_sum"

# One stable path for every snapshot: Restic's retention groups by host and
# path by default, and a per-run name would give each snapshot its own group.
# The release is recorded in a tag and the time in the snapshot itself.
name="pocketboard.dump"
restic backup --json --host pocketboard --tag pocketboard --tag pre-deploy --tag "sha-$sha" \
  --stdin --stdin-filename "$name" < "$dump" > "$work/backup.json"
snapshot="$(grep -o '"snapshot_id":"[0-9a-f]*"' "$work/backup.json" | cut -d'"' -f4 | tail -n 1)"
[[ "$snapshot" =~ ^[0-9a-f]{8,64}$ ]] || die "restic reported no snapshot id"

remote_sum="$(restic dump "$snapshot" "/$name" | sha256sum | cut -d' ' -f1)"
[[ "$remote_sum" == "$local_sum" ]] || die "snapshot $snapshot does not match the local dump"

# Retention is housekeeping; a verified snapshot already exists, so a failure
# here is reported without blocking the deploy. Grouping by host alone keeps
# the per-release tags from splitting snapshots into groups of one.
restic forget --host pocketboard --tag pocketboard --group-by host --keep-last 5 \
  --keep-daily 7 --keep-weekly 4 --keep-monthly 3 --prune > /dev/null \
  || log "WARNING: retention (restic forget --prune) failed; the new snapshot is unaffected"

log "verified backup: snapshot $snapshot, file /$name, $bytes bytes, sha256 $local_sum"
