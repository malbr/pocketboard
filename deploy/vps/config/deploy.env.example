# /etc/pocketboard/deploy.env (root:root 0644). Non-secret settings for the
# deploy unit. Never put a credential in this file.

# Public origin served by the host's TLS reverse proxy. The deploy fails
# unless $PUBLIC_URL/api/health answers through it.
PUBLIC_URL=https://<name>.dedyn.io

# Loopback port the web container publishes; the reverse proxy targets it.
WEB_PORT=8080
