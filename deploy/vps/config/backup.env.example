# /etc/pocketboard/backup.env (root:root 0600). Names only: the owner fills in
# the values on the VPS. Never commit, paste, or send the filled-in file.
# Keep a copy of RESTIC_PASSWORD off the VPS; without it no backup can be
# restored.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/pocketboard-backups
RESTIC_PASSWORD=
# R2 API token scoped to Object Read & Write on the pocketboard-backups bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
