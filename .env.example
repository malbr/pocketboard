# The web app talks to the API through Vite's dev-server proxy at /api
# (see packages/web/vite.config.ts) so no VITE_API_URL is needed for local dev.
DATABASE_URL=postgres://pocketboard:pocketboard@127.0.0.1:5432/pocketboard
API_PORT=3000

# Absolute base URL the browser uses. GitHub redirects back to
# ${APP_BASE_URL}/api/auth/github/callback and matches the OAuth app's
# registered callback URL EXACTLY, so use 127.0.0.1 rather than localhost:
# the two are not interchangeable to GitHub even though they resolve alike.
APP_BASE_URL=http://127.0.0.1:5173

# Owner-only GitHub OAuth. These variables hold FILE PATHS, never the values
# themselves: secrets live in files (root-owned in production) so they stay out
# of the environment, process listings, shell history, and this repository.
# Create them locally with your own throwaway OAuth app, for example:
#
#   mkdir -p secrets   # already gitignored
#   printf '%s' "<client id from your OAuth app>"     > secrets/github-client-id
#   printf '%s' "<client secret from your OAuth app>" > secrets/github-client-secret
#   openssl rand -hex 32                              > secrets/session-secret
#   printf '%s' "<your numeric GitHub user id>"       > secrets/owner-github-user-id
#
# The numeric user id (not the login handle, which can be renamed) comes from
# https://api.github.com/users/<your-login>. The API refuses to start if any of
# these files is missing, unreadable, empty, or invalid.
GITHUB_OAUTH_CLIENT_ID_FILE=./secrets/github-client-id
GITHUB_OAUTH_CLIENT_SECRET_FILE=./secrets/github-client-secret
SESSION_SECRET_FILE=./secrets/session-secret
OWNER_GITHUB_USER_ID_FILE=./secrets/owner-github-user-id

# Which peers may set X-Forwarded-Proto / X-Forwarded-For. In production the
# session cookie is Secure, and a Secure cookie is only sent over a connection
# the API can see as TLS — so behind a TLS-terminating reverse proxy this must
# name that proxy, or login silently sets no cookie at all.
#
# Set it to a comma-separated list of proxy addresses or CIDR networks, for
# example `127.0.0.1` or `172.18.0.0/16` for a Compose network. Set it to the
# literal `none` when the API terminates TLS itself. `true`, `*`, a hop count,
# a hostname, and any /0 network are refused: they would let any caller claim an
# https connection. NODE_ENV=production refuses to start until this is set.
# Unset outside production, where cookies are not Secure anyway.
# TRUSTED_PROXY_IPS=127.0.0.1

# Server log level (fatal, error, warn, info, debug, trace). Unexpected 5xx
# detail is logged here and never returned to the caller.
# LOG_LEVEL=info
